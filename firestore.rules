rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /pairs/{pair}/players/{player} {
      allow read: if request.auth != null && pair == 'HDzAwqJ7yVFqTTgJX3o1LMU3';

      // 傑的花園：只有傑的 Google 帳號能寫
      allow write: if pair == 'HDzAwqJ7yVFqTTgJX3o1LMU3'
                   && player == 'j'
                   && request.auth != null
                   && request.auth.uid == 'qifNMG7nHfPqPoDWkmcJBaygklk1'
                   && request.resource.data.keys().size() < 30;

      // 彣的花園：不用登入（匿名）就能寫
      allow write: if pair == 'HDzAwqJ7yVFqTTgJX3o1LMU3'
                   && player == 'her'
                   && request.auth != null
                   && request.resource.data.keys().size() < 30;
    }
  }
}
